# Copy to .env.local and fill in. All are optional — the app runs without them.

# Deployment base path. Unset = "/FullHearts" (GitHub Pages project site).
# Set to "" (empty) when moving to a root / custom domain.
NEXT_PUBLIC_BASE_PATH=

# Canonical site URL, used for SEO (sitemap, robots, OG, canonical).
NEXT_PUBLIC_SITE_URL=https://yatovoid.github.io/FullHearts

# Google Search Console HTML-tag verification token (optional).
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# Server-host affiliate links. BisectHosting is the primary CTA (modpack-
# friendly, creator program); Shockbyte ($4/sale) is the budget secondary.
# Defaults are baked in-code; override here to change accounts.
NEXT_PUBLIC_HOST_REF_BISECT=
NEXT_PUBLIC_HOST_REF=

# Google AdSense. Leave blank to disable ads entirely (no script, no slots render).
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_RESULTS=
NEXT_PUBLIC_ADSENSE_SLOT_EXPLORE=

# EduCraft (/server, /admin). These need the Node server build, which is the default.

# Email through Resend (resend.com). Without these, production keeps emails
# queued (visible in /admin) and development prints them to the console.
# MAIL_FROM must be on a domain verified in Resend, e.g.
# "EduCraft <hello@send.fullhearts.app>".
RESEND_API_KEY=
MAIL_FROM=
MAIL_REPLY_TO=

# Comma-separated. Gets "new request" and problem alerts, never child names.
ADMIN_ALERT_EMAILS=

# Required to log in to /admin. Generate with:
#   node scripts/hash-admin-password.mjs "yourpassword"
ADMIN_PASSWORD_HASH=

# Required to log in to /admin. Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Required in production for parent sign-in codes. Generate with: openssl rand -hex 32
LOGIN_CODE_PEPPER=

# Shown to parents on the account page and in emails as the place to ask questions.
EDUCRAFT_CONTACT_EMAIL=

# Stripe, in the EduCraft account (never Quiet Courier's). Leave BILLING_ENABLED
# unset or 0 until test mode has been run end to end.
BILLING_ENABLED=0
# A restricted key (rk_...) with: Customers write, Checkout Sessions write,
# Subscriptions write, Customer portal write, Refunds write, Prices read,
# Invoices read.
STRIPE_SECRET_KEY=
# The $10.00 USD monthly price. Checkout refuses to run if it doesn't match.
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Signs the pay links in approval emails. Generate with: openssl rand -hex 32
PAY_LINK_SECRET=
